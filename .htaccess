# ============================================================================
# Root .htaccess - Tuition Management System
# ============================================================================

# Tắt duyệt thư mục
Options -Indexes

# Bật RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Điều hướng mọi yêu cầu /api/... vào api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]

    # Cho phép tests.js từ frontend nếu yêu cầu từ root
    RewriteRule ^tests/tests\.js$ tests/tests.js [L]

    # Chặn truy cập trực tiếp vào các thư mục hệ thống nhạy cảm
    RewriteRule ^(api/(lib|handlers)|config|database|logs|backend/(config|models|controllers))/ - [F,L]
    RewriteRule \.(sql|log|ini|env|md)$ - [F,L]

    # Hỗ trợ URL static assets (styles.css, js/*, css/*) nếu gọi từ root
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^styles\.css$ frontend/css/style.css [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^css/(.*)$ frontend/css/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^js/(.*)$ frontend/js/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ frontend/assets/$1 [L]

    # Điều hướng truy cập root vào index.php
    RewriteRule ^$ index.php [L]
</IfModule>

# Cấu hình trang mặc định nếu mod_rewrite không bật
DirectoryIndex index.php frontend/index.html src/index.html index.html

# Cấu hình bảng mã mặc định UTF-8
AddDefaultCharset UTF-8

# Security Headers cho static files và HTML
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none';"
</IfModule>
